# Postgres connection string.
# Production (Vercel + Neon): copy the pooled connection string from the Neon dashboard.
# Local development: scripts/dev-db.ts starts a local Postgres and prints the matching URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# PIN that protects the whole app. The manager types this once per device.
ADMIN_PIN="1234"

# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
