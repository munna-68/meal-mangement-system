# Postgres connection string.
# Production (Vercel + Neon): copy the pooled connection string from the Neon dashboard.
# Local development: scripts/dev-db.ts starts a local Postgres and prints the matching URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# The first owner account, created by `npm run db:seed` when no account exists.
# There is no shared PIN any more: every manager signs in with their own
# username and password, so each change to the register is recorded against a
# person.
#
# ADMIN_PASSWORD must be at least 8 characters and must not be a known default
# ("admin", "password", "12345678", ...). The seed refuses to run otherwise.
ADMIN_USERNAME="owner"
ADMIN_DISPLAY_NAME="Mess Owner"
ADMIN_PASSWORD=""

# Random string used to sign the session cookie. Changing it logs everyone out.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
