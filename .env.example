# Postgres connection string.
# Production (Vercel + Neon): copy the pooled connection string from the Neon dashboard.
# Local development: scripts/dev-db.ts starts a local Postgres and prints the matching URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Manager PIN that protects the whole app. Any string works — it is a single
# shared PIN, not a per-user account. Change this before you host the app.
ADMIN_PIN="admin"

# Random string used to sign the session cookie. Changing it logs everyone out.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
